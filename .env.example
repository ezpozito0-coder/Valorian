# Servidor
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# Seguridad (reemplazar en producción con una clave aleatoria de al menos 64 caracteres)
AUTH_SECRET=cambia_esta_clave_secreta_en_produccion_minimo_64_caracteres_seguros

# Base de datos MySQL en la nube (compatible con Railway, PlanetScale, AWS RDS, etc.)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cronicas_fractura
MYSQL_SSL=false

# Copias de seguridad
BACKUP_RETENTION_DAYS=7
